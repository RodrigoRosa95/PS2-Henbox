+/* SMB auto launch (navegador.elf, 23/10/2026): like the "bdm" mode, but for a game on the network share
+   configured in conf_network.cfg, so the RA watch list and telemetry work exactly as from the menu.
+   argv[1] file name (including extension)  argv[2] game->startup  argv[3] "CD"/"DVD"  argv[4] "smb"
+   Only returns if the share could not be reached; then OPL exits to the configured exit path. */
+static void autoLaunchSMBGame(char *argv[])
+{
+    base_game_info_t *game;
+    int nameLen;
+
+    miniInit(ETH_MODE);
+
+    if ((game = malloc(sizeof(base_game_info_t))) == NULL)
+        sysExecExit();
+    memset(game, 0, sizeof(base_game_info_t));
+
+    int format = isValidIsoName(argv[1], &nameLen);
+    if (format == GAME_FORMAT_OLD_ISO) {
+        strncpy(game->name, &argv[1][GAME_STARTUP_MAX], nameLen);
+        game->name[nameLen] = '\0';
+        strncpy(game->extension, &argv[1][GAME_STARTUP_MAX + nameLen], sizeof(game->extension));
+    } else {
+        strncpy(game->name, argv[1], nameLen);
+        game->name[nameLen] = '\0';
+        strncpy(game->extension, &argv[1][nameLen], sizeof(game->extension));
+    }
+    game->extension[sizeof(game->extension) - 1] = '\0';
+    snprintf(game->startup, sizeof(game->startup), "%s", argv[2]);
+    game->media = strcasecmp("CD", argv[3]) == 0 ? SCECdPS2CD : SCECdPS2DVD;
+    game->format = format;
+    game->parts = 1;
+
+    ethAutoLaunchGame(game); // does not return on success
+
+    LOG("SMB auto launch failed (network status %d)\n", gNetworkStartup);
+    sysExecExit();
+}
