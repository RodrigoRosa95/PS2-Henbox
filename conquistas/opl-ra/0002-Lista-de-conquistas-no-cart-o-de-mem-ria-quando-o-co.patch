 include/rawatch.h |  3 +++
 src/rabadge.c     | 10 ++++++++++
 src/ranet.c       | 15 +++++++++++++++
 src/supportbase.c |  8 ++++++++
 4 files changed, 36 insertions(+)

diff --git a/include/rawatch.h b/include/rawatch.h
index 725889f..11991c6 100644
--- a/include/rawatch.h
+++ b/include/rawatch.h
@@ -7,6 +7,9 @@
 /* "<prefix>RA/<serial>.wl": where a game's list lives on a device. The
    loader, the badge and the network save all use this one. */
 void raWatchListPath(char *out, int sz, const char *prefix, const char *serial);
+/* Memory card fallback (23/10/2026): a read-only share (Samba on an Android TV box cannot write to its USB
+   stick) keeps no list; the OPL folder on the card does. Tried after the game's device and the share. */
+#define RA_MC_PREFIXES {"mc0:OPL/", "mc1:OPL/"}
 int LoadWatchList(const char *path, const char *startup);
 /* One line in the debug launch log: what happened plus two numbers.
    Independent of the hash log, which is already closed by launch time. */
diff --git a/src/rabadge.c b/src/rabadge.c
index c586147..45e4c6b 100644
--- a/src/rabadge.c
+++ b/src/rabadge.c
@@ -82,6 +82,16 @@ static int watchListExists(const char *prefix, const char *serial)
             return 1;
     }
 
+    {   /* memory card copy (read-only share, ranet.c) */
+        static const char *mc[] = RA_MC_PREFIXES;
+        int i;
+        for (i = 0; i < 2; i++) {
+            raWatchListPath(path, sizeof(path), mc[i], serial);
+            if (stat(path, &st) == 0 && st.st_size > 0)
+                return 1;
+        }
+    }
+
     return 0;
 }
 
diff --git a/src/ranet.c b/src/ranet.c
index dddfd1a..451e905 100644
--- a/src/ranet.c
+++ b/src/ranet.c
@@ -512,6 +512,21 @@ int raAskPC(const char *hash, const char *serial, const char *savepath,
             LOG("RA: list saved: %s (%d bytes)\n", file, total);
         }
 
+        if (saved == 0) {   /* read-only share: keep it on the memory card instead */
+            static const char *mc[] = RA_MC_PREFIXES;
+            for (w = 0; w < 2 && saved == 0; w++) {
+                snprintf(dir, sizeof(dir), "%sRA", mc[w]);
+                mkdir(dir, 0777);
+                raWatchListPath(file, sizeof(file), mc[w], serial);
+                if ((f = fopen(file, "wb")) == NULL)
+                    continue;
+                fwrite(g_wl, 1, (size_t)total, f);
+                fclose(f);
+                saved++;
+                LOG("RA: list saved on the memory card: %s (%d bytes)\n", file, total);
+            }
+        }
+
         if (saved == 0)
             raHashStep("9x-file-not-written");
     }
diff --git a/src/supportbase.c b/src/supportbase.c
index 80fd6c0..c4b0a44 100644
--- a/src/supportbase.c
+++ b/src/supportbase.c
@@ -1027,6 +1027,14 @@ int sbLoadWatchList(const char *path, const char *file)
         raLaunchNote("wl-from-share", n, 0);
     }
 
+    if (n < 0) {   /* saved on the memory card when the share is read-only (ranet.c) */
+        static const char *mc[] = RA_MC_PREFIXES;
+        int i;
+        for (i = 0; i < 2 && n < 0; i++)
+            n = LoadWatchList(mc[i], file);
+        raLaunchNote("wl-from-mc", n, 0);
+    }
+
     raLaunchNote("wl-total", n, GetWatchBytes());
 
     /* A list means telemetry, and telemetry needs the adapter up before
