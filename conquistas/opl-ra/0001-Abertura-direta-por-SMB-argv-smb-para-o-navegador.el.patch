+/* SMB auto launch (opl.c autoLaunchSMBGame): network up, share open, then the same ethLaunchGame as the menu.
+   Takes ownership of game. Returns only on failure. */
+void ethAutoLaunchGame(base_game_info_t *game)
+{
+    gAutoLaunchSMB = 1;
+    if (ethInitSema() < 0)
+        return;
+    ethBase = "smb0:";
+    gNetworkStartup = ERROR_ETH_NOT_STARTED;
+
+    WaitSema(ethInitSemaID);
+    int ret = ethLoadModules();
+    SignalSema(ethInitSemaID);
+    if (ret != 0 || sysLoadModuleBuffer(&smbman_irx, size_smbman_irx, 0, NULL) < 0)
+        return;
+    sysLoadModuleBuffer(&nbns_irx, size_nbns_irx, 0, NULL);
+    nbnsInit();
+
+    WaitSema(ethInitSemaID);
+    ret = ethInitApplyConfig();
+    SignalSema(ethInitSemaID);
+    if (ret != 0)
+        return;
+    ethSMBConnect();
+    if (gNetworkStartup != 0 || !gPCShareName[0])
+        return;
+
+    ethGames = game;
+    ethGameCount = 1;
+    ethLaunchGame(&ethGameList, 0, sbPopulateConfig(game, ethPrefix, "\\"));
+}
+
 static config_set_t *ethGetConfig(item_list_t *itemList, int id)
 {
     return sbPopulateConfig(&ethGames[id], ethPrefix, "\\");
